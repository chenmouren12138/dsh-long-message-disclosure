{
  "name": "@local/dsh-long-message-disclosure",
  "version": "1.0.0",
  "private": true,
  "description": "长消息渐进披露：在对话时间线中把超过阈值的用户消息正文默认折叠为裁剪预览，通过 WAI-ARIA Disclosure 触发器展开或收起；折叠态不挂载完整正文，展开保持视口锚定。",
  "type": "module",
  "license": "Unlicense",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "conversation",
    "disclosure",
    "accessibility",
    "wai-aria"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
