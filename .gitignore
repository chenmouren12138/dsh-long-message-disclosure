# .gitignore — @local/dsh-long-message-disclosure
#
# 这是一个零依赖、无构建步骤的 DSH 插件包；下面只保留实际会出现在本目录里的产物。

# ── 依赖 ────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── 日志 ────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── 构建 / 测试产物（当前无构建，留给以后） ──────────────
dist/
build/
out/
coverage/
*.tsbuildinfo
*.tgz
.cache/

# ── 环境变量与密钥 ──────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# ── 编辑器 / 操作系统 ───────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# ── 本地临时文件 ────────────────────────────────────────
*.local.*
*.bak
*.tmp
